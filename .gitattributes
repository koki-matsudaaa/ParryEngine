*.h       text eol=crlf
*.hlsl    text eol=crlf
*.hlsli   text eol=crlf
*.vcxproj text eol=crlf
*.props   text eol=crlf
*.sln     text eol=crlf
*.json    text eol=crlf
*.md      text eol=crlf
